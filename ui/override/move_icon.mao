<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- DAOTurnBased: the game's move_icon material object (the movement marker's four arrows), with the semantic of GeneralGui.mat that takes a colour (dev/UI.md, "The movement preview"). -->
<MaterialObject Name="move_icon">
	<Material Name="GeneralGui.mat"></Material>
	<DefaultSemantic Name="ReticalTint"></DefaultSemantic>
	<Texture Name="mml_tDiffuse" ResName="vfx_movearrow.dds"></Texture>
</MaterialObject>
