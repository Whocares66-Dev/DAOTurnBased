<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- DAOTurnBased: the game's move_indicator material object, with the semantic of GeneralGui.mat that takes a colour (dev/UI.md, "The movement preview"). The game's own marker passes none and looks as it did. -->
<MaterialObject Name="move_indicator">
	<Material Name="GeneralGui.mat"></Material>
	<DefaultSemantic Name="ReticalTint"></DefaultSemantic>
	<Texture Name="mml_tDiffuse" ResName="vfx_movetarget.dds"></Texture>
</MaterialObject>
